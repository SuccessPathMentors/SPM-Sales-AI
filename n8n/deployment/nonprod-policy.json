{
  "schema": "SPM_N8N_NONPROD_POLICY_V1",
  "status": "MIG-003_NON_PRODUCTION_ONLY",
  "allowed_environments": ["dev", "staging"],
  "protected_production_workflows": [
    {
      "id": "CMBMpxX5AqqK2UTn",
      "name": "SPM_RC4_3_3_PRODUCTION_FINAL_2026-08-28.json",
