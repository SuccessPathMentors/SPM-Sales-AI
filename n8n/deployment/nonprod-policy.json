    "existing_target_must_be_inactive": true,
    "environment_name_prefix_required": true,
    "implicit_create_allowed": false,
    "production_publish_allowed": false,
    "credential_secret_values_in_repo_allowed": false
  },
  "github_environments": {
    "dev": "n8n-dev",
    "staging": "n8n-staging"
  },
  "required_environment_secrets_for_apply": [
    "N8N_API_BASE_URL",
    "N8N_API_KEY"
  ],
  "optional_environment_secret_after_first_create": "N8N_TARGET_WORKFLOW_ID"
}
