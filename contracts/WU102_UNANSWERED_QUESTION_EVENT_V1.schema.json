{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SPM_WU102_UNANSWERED_QUESTION_EVENT_V1",
  "title": "SPM WU102 Unanswered Question Queue Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_schema",
    "queue_event_id",
    "event_timestamp",
    "workflow_release",
    "channel",
    "queue_session_key",
    "turn_index",
    "redacted_question",
    "question_capture_status",
    "language",
    "dialect_hint",
    "predicted_intent",
    "secondary_intent",
    "confidence",
    "kb_match_status",
    "fallback_used",
    "clarification_used",
    "human_requested",
    "out_of_scope",
    "trigger_reasons",
    "resolution_status",
    "approved_answer_status",
    "added_to_kb_status",
    "pii_redacted",
    "raw_message_logged",
    "raw_session_logged",
    "secret_values_logged"
  ],
  "properties": {
    "event_schema": {"const": "SPM_WU102_UNANSWERED_QUESTION_V1"},
    "queue_event_id": {"type": "string", "pattern": "^uq-[A-Za-z0-9._:-]{12,180}$"},
    "event_timestamp": {"type": "string", "format": "date-time"},
    "workflow_release": {"type": "string", "minLength": 1, "maxLength": 120},
    "channel": {"type": "string", "enum": ["website_chat", "unknown"]},
    "queue_session_key": {"type": "string", "pattern": "^conv-[A-Za-z0-9._:-]{12,160}$"},
    "turn_index": {"type": "integer", "minimum": 1},
    "redacted_question": {"type": ["string", "null"], "maxLength": 1500},
    "question_capture_status": {"type": "string", "enum": ["STORED_REDACTED", "WITHHELD_PII_RISK"]},
    "language": {"type": "string", "enum": ["en", "ar", "fr", "unknown"]},
    "dialect_hint": {"const": "unknown"},
    "predicted_intent": {"type": ["string", "null"], "maxLength": 120},
    "secondary_intent": {"type": ["string", "null"], "maxLength": 120},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "kb_match_status": {"type": "string", "enum": ["MATCHED", "NO_STATIC_EVIDENCE", "NOT_APPLICABLE_LIVE_REQUIRED", "UNKNOWN"]},
    "fallback_used": {"type": "boolean"},
    "clarification_used": {"type": "boolean"},
    "human_requested": {"type": "boolean"},
    "out_of_scope": {"type": "boolean"},
    "trigger_reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "NO_STATIC_EVIDENCE",
          "LOW_CONFIDENCE_FALLBACK",
          "AMBIGUOUS_OR_BELOW_THRESHOLD",
          "FALLBACK_USED",
          "HUMAN_REQUESTED",
          "OUT_OF_SCOPE"
        ]
      }
    },
    "resolution_status": {"const": "OPEN"},
    "approved_answer_status": {"const": "NOT_REVIEWED"},
    "added_to_kb_status": {"const": "NOT_ADDED"},
    "pii_redacted": {"const": true},
    "raw_message_logged": {"const": false},
    "raw_session_logged": {"const": false},
    "secret_values_logged": {"const": false}
  }
}
