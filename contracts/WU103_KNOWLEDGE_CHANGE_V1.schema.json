{
  "$id": "SPM_WU103_KNOWLEDGE_CHANGE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_schema","change_id","candidate_key","source_queue_event_id","created_at","updated_at","change_state","review_decision","target_family","change_type","target_record_id","target_id_field","base_revision","candidate_revision","base_fingerprint_sha256","candidate_payload_sha256","language_scope","intent_mapping","source_reference","source_type","business_truth_approval","regression_case_ids","regression_evidence_sha256","regression_payload_sha256","regression_status","release_approval_status","publish_environment","publish_status","published_at","published_record_id","published_payload_sha256","supersedes_change_id","reviewer_note","pii_reviewed","raw_customer_message_logged","raw_session_logged","secret_values_logged","candidate_payload_json"
  ],
  "properties": {
    "change_schema": {"const": "SPM_WU103_KNOWLEDGE_CHANGE_V1"},
    "change_id": {"type": "string", "pattern": "^chg-[a-z0-9-]+$"},
    "candidate_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_queue_event_id": {"type": "string", "pattern": "^uq-"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "change_state": {"enum": ["DRAFT","HUMAN_APPROVED","TEST_PASSED","RELEASE_APPROVED","PUBLISHED","REJECTED","SUPERSEDED","BLOCKED"]},
    "review_decision": {"enum": ["PENDING","APPROVED","REJECTED"]},
    "target_family": {"enum": ["FAQ","SUBJECTS","SUBJECT_PATHWAYS","SERVICES","LOCATIONS","FALLBACKS","PACKAGES","POLICIES"]},
    "change_type": {"enum": ["ADD","UPDATE"]},
    "target_record_id": {"type": ["string","null"]},
    "target_id_field": {"enum": ["record_id","pathway_id","service_id"]},
    "base_revision": {"type": ["string","null"], "pattern": "^(LEGACY_UNVERSIONED|v[1-9][0-9]*)$"},
    "candidate_revision": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "base_fingerprint_sha256": {"type": ["string","null"], "pattern": "^[a-f0-9]{64}$"},
    "candidate_payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "language_scope": {"type": "array", "items": {"enum": ["en","ar","fr"]}, "uniqueItems": true, "minItems": 1},
    "intent_mapping": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_reference": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["WEBSITE","ATTACHMENT","QUALITY_NOTE","OWNER_DECISION","INTERNAL_APPROVED_SOURCE"]},
    "business_truth_approval": {"type": "boolean"},
    "regression_case_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "regression_evidence_sha256": {"type": ["string","null"], "pattern": "^[a-f0-9]{64}$"},
    "regression_payload_sha256": {"type": ["string","null"], "pattern": "^[a-f0-9]{64}$"},
    "regression_status": {"enum": ["NOT_RUN","PASS","FAIL","INVALIDATED"]},
    "release_approval_status": {"enum": ["NOT_APPROVED","APPROVED"]},
    "publish_environment": {"const": "STAGING"},
    "publish_status": {"enum": ["NOT_PUBLISHED","PUBLISHED","FAILED","BLOCKED"]},
    "published_at": {"type": ["string","null"], "format": "date-time"},
    "published_record_id": {"type": ["string","null"]},
    "published_payload_sha256": {"type": ["string","null"], "pattern": "^[a-f0-9]{64}$"},
    "supersedes_change_id": {"type": ["string","null"]},
    "reviewer_note": {"type": ["string","null"]},
    "pii_reviewed": {"type": "boolean"},
    "raw_customer_message_logged": {"const": false},
    "raw_session_logged": {"const": false},
    "secret_values_logged": {"const": false},
    "candidate_payload_json": {"type": "string", "minLength": 2}
  }
}
